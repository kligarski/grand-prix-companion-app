{
  "expo": {
    "name": "Grand Prix Companion",
    "slug": "grand-prix-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gpcompanion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.gpcompanion"
    },
    "android": {
      "package": "com.gpcompanion",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/SairaSemiCondensed-Medium.ttf",
              "./assets/fonts/SairaSemiCondensed-SemiBold.ttf",
              "./assets/fonts/SairaSemiCondensed-Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Saira SemiCondensed",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SairaSemiCondensed-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SairaSemiCondensed-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/SairaSemiCondensed-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
